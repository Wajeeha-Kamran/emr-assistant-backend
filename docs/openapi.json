        "summary": "Get Soap Note",
        "description": "Fetch the SOAP note for a session, with its four sections.\n\n`status` is DRAFT or SIGNED. A signed note is immutable: edits and\nregenerated suggestions are both rejected.",
        "operationId": "get_soap_note_api_v1_sessions__session_id__soap_notes_get",
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ],
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Session Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SOAPNoteResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/soap-notes/{note_id}/sections/{section_id}": {
      "patch": {
        "tags": [
          "soap_notes"
        ],
        "summary": "Update Soap Section",
        "description": "Edit one section of a draft SOAP note.\n\nThis is the clinician review step the whole system is built around — the\ngenerated note is a starting point, and this is where it becomes correct.\n\nEmpty content is rejected with 422. A section belonging to a different note\nis rejected with 400. Editing a signed note returns 409: signing is\ndeliberately irreversible, because a clinical record that can be altered\nafter signature is not a record.",
        "operationId": "update_soap_section_api_v1_soap_notes__note_id__sections__section_id__patch",
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ],
        "parameters": [
          {
            "name": "note_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Note Id"
            }
          },
          {
            "name": "section_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Section Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SOAPSectionUpdateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SOAPNoteResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/soap-notes/{note_id}/code-suggestions/generate": {
      "post": {
        "tags": [
          "code_suggestions"
        ],
        "summary": "Generate Code Suggestions",
        "description": "Generate ranked ICD-10 and CPT suggestions for a note.\n\nDiagnosis codes are drawn from the Assessment section and procedure codes\nfrom the Plan section, matched against the reference code set by clinical\nsimilarity. Returns five of each, ranked 1 to 10 with no gaps.\n\nRegenerating replaces the previous suggestions. A signed note returns 409.\n\nSuggestions are proposals for the clinician to accept, not billing\ndecisions.",
        "operationId": "generate_code_suggestions_api_v1_soap_notes__note_id__code_suggestions_generate_post",
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ],
        "parameters": [
          {
            "name": "note_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Note Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CodeSuggestionResponse"
                  },
                  "title": "Response Generate Code Suggestions Api V1 Soap Notes  Note Id  Code Suggestions Generate Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
