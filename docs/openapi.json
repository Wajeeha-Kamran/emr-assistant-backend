      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Register",
        "description": "Register a new doctor account.\n\nThe email must be unique; a duplicate returns 400. The password is hashed\nbefore storage and is never returned by any endpoint.\n\nRegistration does not log you in — call /login next to obtain a token.",
        "operationId": "register_api_v1_auth_register_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DoctorCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
