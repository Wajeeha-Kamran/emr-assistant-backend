    "/api/v1/sessions/{session_id}/stop-recording": {
      "post": {
        "tags": [
          "sessions"
        ],
        "summary": "Stop Recording",
        "description": "Upload the consultation audio and end the recording.\n\nAccepts a multipart file. Common audio and video container types are\naccepted, including all the MIME spellings of WAV that clients use in\npractice — Windows reports `audio/wave` where browsers send `audio/wav`.\n\nReturns as soon as the file is stored and validated. **Transcription then\nruns in the background** and takes roughly as long as the recording itself\non CPU, so do not expect a transcript immediately; poll the transcript\nendpoint.\n\nRecordings longer than the configured maximum are rejected with 400.",
        "operationId": "stop_recording_api_v1_sessions__session_id__stop_recording_post",
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ],
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Session Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_stop_recording_api_v1_sessions__session_id__stop_recording_post"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/sessions/{session_id}/transcript": {
      "get": {
        "tags": [
          "transcripts"
        ],
        "summary": "Get Transcript",
        "description": "Fetch the transcript, with each segment labelled DOCTOR or PATIENT.\n\n**Poll this endpoint.** `status` is `processing` until transcription\nfinishes, then `completed`, or `failed` if it did not. A SOAP note cannot be\ngenerated until the status is `completed`.\n\nSegments are returned in chronological order.\n\nSpeaker labels are produced by a diarization pipeline whose accuracy has been\nmeasured rather than assumed: it meets its target when the two voices are\nacoustically distinguishable and speak at a conversational pace, and degrades\nwhen the voices are similar or turn-taking is rapid. Clients should treat\nspeaker labels as correctable by the clinician, not as ground truth. See\ndocs/module_9_1_accuracy.md.",
        "operationId": "get_transcript_api_v1_sessions__session_id__transcript_get",
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ],
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Session Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TranscriptResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/sessions/{session_id}/transcript/retry": {
      "post": {
        "tags": [
          "transcripts"
        ],
        "summary": "Retry Transcription",
        "description": "Re-run transcription for a session whose transcript failed.\n\nResets the transcript to `processing` and starts the pipeline again, so any\npreviously produced segments are replaced.\n\nReturns 409 if transcription is already running — the guard prevents two\npasses writing segments for the same session at once. Note that calling this\non a transcript that already completed will discard it and start over.",
        "operationId": "retry_transcription_api_v1_sessions__session_id__transcript_retry_post",
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ],
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Session Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/sessions/{session_id}/soap-notes/generate": {
      "post": {
        "tags": [
          "soap_notes"
        ],
        "summary": "Generate Soap Note Draft",
        "description": "Generate a draft SOAP note from the completed transcript.\n\nRequires a transcript with status `completed`; otherwise returns 409.\n\nThe pipeline is extractive: every word in the note comes from the transcript,\nnothing is invented. Patient speech becomes Subjective; doctor speech is\nclassified sentence by sentence into Objective, Assessment and Plan.\nQuestions, greetings and announcements are excluded, since they document\nnothing.\n\nRegenerating replaces an existing draft and its code suggestions. A signed\nnote cannot be regenerated and returns 409.\n\n**This is a draft for clinical review.** Classification of Assessment in\nparticular is known to be weak — diagnostic statements are frequently filed\nunder Objective. Clients must present this as editable. See\ndocs/module_3_soap_classification.md.",
        "operationId": "generate_soap_note_draft_api_v1_sessions__session_id__soap_notes_generate_post",
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ],
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Session Id"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SOAPNoteResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/sessions/{session_id}/soap-notes": {
      "get": {
        "tags": [
          "soap_notes"
