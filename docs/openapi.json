    "/api/v1/soap-notes/{note_id}/sync-status": {
      "get": {
        "tags": [
          "emr_sync"
        ],
        "summary": "Get Sync Status",
        "description": "Report the status of the background sync to the external EMR.\n\nSigning queues the sync; it does not complete synchronously. Poll here.\nA failed sync leaves the note intact and the session's audio undeleted, so\nnothing is lost and the sync can be retried.",
        "operationId": "get_sync_status_api_v1_soap_notes__note_id__sync_status_get",
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ],
        "parameters": [
          {
            "name": "note_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Note Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SyncStatusResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
