    "/api/v1/soap-notes/{note_id}/sign": {
      "post": {
        "tags": [
          "signatures"
        ],
        "summary": "Sign Soap Note",
        "description": "Sign the note. This is the irreversible step.\n\nSigning does three things: it locks the note against further edits, it marks\nthe session finalised so its audio becomes eligible for deletion, and it\ntriggers a background sync to the external EMR.\n\nA note can only be signed once; a second attempt returns 409.\n\nClients should treat this as a deliberate action requiring confirmation. Up\nto this point everything the system produced was a draft under review; after\nit, the note is a clinical record.",
        "operationId": "sign_soap_note_api_v1_soap_notes__note_id__sign_post",
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ],
        "parameters": [
          {
            "name": "note_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Note Id"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignatureResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
