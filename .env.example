APP_ENV=development
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD_HERE@localhost:5432/emr_assistant
SIMULATED_EMR_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD_HERE@localhost:5432/simulated_emr
SIMULATED_EMR_URL=http://localhost:8001

JWT_SECRET=your-super-secret-key-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

RETENTION_WINDOW_MINUTES=4
RETENTION_SWEEP_INTERVAL_SECONDS=60

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=generate-a-fernet-key-see-above

# Where uploaded recordings are written. A relative path is resolved from the
# repository root.
AUDIO_STORAGE_DIR=./storage/audio

# Hugging Face read token. OPTIONAL since 8 September 2026.
#
# The default diarizer is NeMo Sortformer, whose checkpoint is openly
# downloadable -- no token, no licence to accept. Leave this empty and the
# system transcribes and diarizes normally.
#
# It is needed only by the pyannote FALLBACK, which runs if Sortformer cannot
# load (most often because the interpreter is not Python 3.12). Worth setting as
# insurance; without it, a Sortformer failure drops straight to the much weaker
# window/embedding methods.
#
# To enable the fallback: create a read token at huggingface.co/settings/tokens,
# then accept the licence on all three gated repositories:
#   pyannote/segmentation-3.0
#   pyannote/speaker-diarization-3.1
#   pyannote/speaker-diarization-community-1
HF_TOKEN=

# sortformer (default) | pyannote | window | embedding | pause
# sortformer requires Python 3.12 and nemo_toolkit[asr].
DIARIZATION_METHOD=sortformer

# extractive (default) | llm | remote
# "llm" and "remote" both rewrite the selected sentences as prose; neither
# ever sees the raw transcript. Run scripts/evaluate_groundedness.py before
# trusting one. "llm" loads the model inside the backend, which adds ~8 GB to
# that process; "remote" calls a model running in its own process on this
# machine, which is what a 15.8 GB laptop running Whisper and Sortformer
# needs. Both apply the grounding gate inside the backend.
SOAP_ENGINE=extractive
LLM_MODEL_ID=

# Only used when SOAP_ENGINE=remote. Start the service first:
#     python -m scripts.llm_service --model google/medgemma-4b-it
# Keep this on 127.0.0.1. The project document (6.1) states that every model
# runs on the same machine as the backend and that no clinical text reaches a
# third party service; a remote address makes that untrue and is logged as a
# warning on every start.
LLM_SERVICE_URL=http://127.0.0.1:8002
# A runaway guard, not a performance budget. When it fires the note falls
# back to the verbatim rendering instead of failing. A 4B model on CPU can
# take minutes per section.
LLM_SERVICE_TIMEOUT_SECONDS=600

# Reject generated sentences the transcript does not support and fall back to
# the verbatim rendering for that section. Leave on: two models each invented a
# pertinent negative under a prompt that explicitly forbade it.
LLM_GROUNDING_GATE=true
LLM_GROUNDING_THRESHOLD=0.5
