APP_ENV=development
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD_HERE@localhost:5432/emr_assistant
SIMULATED_EMR_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD_HERE@localhost:5432/simulated_emr
SIMULATED_EMR_URL=http://localhost:8001

JWT_SECRET=your-super-secret-key-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

RETENTION_WINDOW_MINUTES=4
RETENTION_SWEEP_INTERVAL_SECONDS=60

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=generate-a-fernet-key-see-above