APP_ENV=development
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD_HERE@localhost:5432/emr_assistant
SIMULATED_EMR_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD_HERE@localhost:5432/simulated_emr
SIMULATED_EMR_URL=http://localhost:8001

JWT_SECRET=your-super-secret-key-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

RETENTION_WINDOW_MINUTES=4
RETENTION_SWEEP_INTERVAL_SECONDS=60

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=generate-a-fernet-key-see-above

# Where uploaded recordings are written. A relative path is resolved from the
# repository root.
AUDIO_STORAGE_DIR=./storage/audio

# Hugging Face read token. REQUIRED for speaker diarization. Without it the API
# still starts and audio still uploads, but transcription fails the moment
# pyannote loads -- which is the step the whole system is built around, so the
# failure looks like a broken pipeline rather than a missing setting.
#
# Create a read token at huggingface.co/settings/tokens, then accept the licence
# on all three gated repositories:
#   pyannote/segmentation-3.0
#   pyannote/speaker-diarization-3.1
#   pyannote/speaker-diarization-community-1
HF_TOKEN=
